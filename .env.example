# Copy this file to `.env.local` (which is git-ignored) and fill in real values.
# Both Next.js and the Prisma CLI (prisma.config.ts) read `.env.local`.
#
# ─── Database ──────────────────────────────────────────────────────
# Neon PostgreSQL connection string (get it from https://neon.tech → your project → Connection string)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/kyosys?sslmode=require"

# ─── Auth (Auth.js v5 — used in Sprint 2, US-040) ─────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Seed-only: the single shared admin login (PRD §9.5).
# Set these ONLY when running `npx prisma db seed`. Never commit real values.
# IMPORTANT: the seed takes a pre-computed bcrypt HASH, never a raw password.
# Generate it locally (bcrypt cost 12) with:
#   node -e "require('bcryptjs').hash('YOUR_STRONG_PASSWORD', 12).then(console.log)"
ADMIN_EMAIL="admin@kyosys.com"
ADMIN_PASSWORD_HASH="$2b$12$REPLACE_WITH_REAL_BCRYPT_HASH"

# ─── Email (Resend — used in Sprint 2, US-030/US-031) ─────────────────
RESEND_API_KEY=""
# Where contact/quote notification emails are sent:
TEAM_EMAIL="hello@kyosys.com"

# ─── Uploads (Vercel Blob — used in Sprint 2, US-042) ─────────────────
BLOB_READ_WRITE_TOKEN=""

# ─── Site ─────────────────────────────────────────────────────────────
# Public contact details (shown on site; replace placeholders before launch — US-050)
NEXT_PUBLIC_SITE_URL="https://kyosys.com"
NEXT_PUBLIC_CONTACT_EMAIL="hello@kyosys.com"
NEXT_PUBLIC_CONTACT_PHONE="+91 98765 43210"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
